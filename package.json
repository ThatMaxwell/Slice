{
  "name": "slice-browser",
  "productName": "Slice",
  "version": "0.1.1",
  "description": "Slice — an AI-native browser. Say it, Slice does it.",
  "main": "src/main/main.js",
  "author": "Slice",
  "homepage": "https://thatmaxwell.github.io/Slice/",
  "repository": "https://github.com/ThatMaxwell/Slice",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "paparazzi": "node scripts/paparazzi.js"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.1"
  },
  "build": {
    "appId": "app.slice.browser",
    "productName": "Slice",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/brand/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Slice",
      "artifactName": "Slice-Setup.exe"
    },
    "protocols": [
      {
        "name": "Web",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "HTML document",
        "role": "Viewer"
      }
    ],
    "portable": {
      "artifactName": "Slice-Portable.exe"
    }
  }
}
